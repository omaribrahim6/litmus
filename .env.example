# Copy to .env (worker, station) and web/.env.local (web). Never commit real values.

# --- Tiger Data (TimescaleDB + pgvector) ---
# postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
DATABASE_URL=

# --- Google Gemini (AI Studio key) ---
GEMINI_API_KEY=
# Model ids are configurable so we can follow whatever is newest at the event.
GEMINI_MODEL_FLASH=
GEMINI_MODEL_FLASH_LITE=
GEMINI_MODEL_PRO=
GEMINI_MODEL_EMBED=
GEMINI_MODEL_TTS=

# --- Optional: Vertex AI instead of AI Studio ---
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- Worker ---
# Shared secret the station sends as "Authorization: Bearer <token>" on ingest.
WORKER_TOKEN=
# Where the worker stores frames and videos it serves under /media.
MEDIA_DIR=
# Public base URL of the worker (used to build absolute media URLs).
PUBLIC_WORKER_URL=
# Comma-separated origins allowed to call the worker from a browser.
CORS_ORIGINS=

# --- Web (web/.env.local) ---
# Server-side calls from Next.js to the worker.
WORKER_URL=
# Browser-side worker URL (media, video upload).
NEXT_PUBLIC_WORKER_URL=
# "1" serves everything from the bundled demo snapshot (no DB, no network).
LITMUS_DEMO_MODE=

# --- Station (Raspberry Pi) ---
STATION_ID=
EXPERIMENT_ID=
# Camera index for OpenCV VideoCapture.
CAMERA_INDEX=
# grove | ads1115 | none
ADC_DRIVER=
